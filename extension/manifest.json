{
  "manifest_version": 3,
  "name": "FF Research Draft Companion",
  "version": "1.0.0",
  "description": "Sends ESPN draft-room picks to the local FF Research helper on 127.0.0.1:8787.",
  "host_permissions": ["http://127.0.0.1:8787/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://fantasy.espn.com/football/draft*",
        "https://fantasy.espn.com/football/mockdraft*",
        "https://fantasy.espn.com/football/tools/draft*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "FF Research Draft Companion" }
}
