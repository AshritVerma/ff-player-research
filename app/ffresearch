#!/bin/bash
# FF Research launcher.
# Starts the draft helper if it isn't already up, pulls the newest commit from
# GitHub if it can, then opens the offline dashboard. Being offline, or the pull failing, never blocks the open --
# that is the entire point of the standalone build.

REPO="$HOME/Code/ff-player-research"
FILE="$REPO/ff-research-standalone.html"
LOG="$REPO/.launcher.log"
PATH="/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin:/opt/homebrew/bin"
export PATH GIT_TERMINAL_PROMPT=0   # never sit at a credential prompt

echo "--- $(date '+%Y-%m-%d %H:%M:%S') launch" >> "$LOG"

if [ -d "$REPO/.git" ]; then
  (
    cd "$REPO" || exit 1
    git fetch --quiet origin 2>&1
    branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo master)"
    git merge --ff-only --quiet "origin/$branch" 2>&1
  ) >> "$LOG" 2>&1 &
  pid=$!

  # Wait up to ~8s for the update, then give up and open what we have.
  n=0
  while kill -0 "$pid" 2>/dev/null && [ "$n" -lt 80 ]; do
    sleep 0.1
    n=$((n + 1))
  done
  if kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null
    echo "update timed out after 8s; opening local copy" >> "$LOG"
  fi
  echo "at $(cd "$REPO" && git rev-parse --short HEAD 2>/dev/null)" >> "$LOG"
fi

# ---- draft helper -------------------------------------------------------
# Starting this by hand in Terminal before every draft was the last piece of
# ceremony. Launch it here instead, detached, and only if nothing is already
# listening -- so double-clicking twice never starts two of them.
start_helper() {
  if curl -s -m 1 -o /dev/null "http://127.0.0.1:8787/api/draft"; then
    echo "helper already running" >> "$LOG"
    return
  fi
  [ -f "$REPO/draft_sync.py" ] || { echo "no draft_sync.py" >> "$LOG"; return; }
  nohup /usr/bin/python3 "$REPO/draft_sync.py" --room-only >> "$LOG" 2>&1 &
  disown 2>/dev/null || true
  n=0
  while [ "$n" -lt 20 ]; do
    curl -s -m 1 -o /dev/null "http://127.0.0.1:8787/api/draft" && break
    sleep 0.25; n=$((n + 1))
  done
  if curl -s -m 1 -o /dev/null "http://127.0.0.1:8787/api/draft"; then
    echo "helper started" >> "$LOG"
  else
    echo "helper FAILED to start" >> "$LOG"
  fi
}
start_helper

if [ -f "$FILE" ]; then
  open "$FILE"
else
  echo "MISSING: $FILE" >> "$LOG"
  osascript -e 'display alert "FF Research" message "Could not find ff-research-standalone.html in ~/Code/ff-player-research." as critical' >/dev/null 2>&1
fi
